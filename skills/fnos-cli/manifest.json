{
  "name": "fnos-cli",
  "version": "0.5.1",
  "description": "使用 fnos-cli 授权并管理 fnOS 设备的文件、照片、应用、Docker、下载、日志、监控、网络、存储、用户和百度网盘。用户提到 fnOS、飞牛系统或国内版设备时使用；不适用于国际版设备或 Media API。",
  "entry": "SKILL.md",
  "bin": {},
  "reference": "reference/",
  "entriesDir": "entries/",
  "entries": [
    "entries/trim-app.md",
    "entries/trim-baidu-netdisk.md",
    "entries/trim-docker.md",
    "entries/trim-download.md",
    "entries/trim-file.md",
    "entries/trim-log.md",
    "entries/trim-monitor.md",
    "entries/trim-network.md",
    "entries/trim-photos.md",
    "entries/trim-shared.md",
    "entries/trim-storage.md",
    "entries/trim-system.md",
    "entries/trim-user.md"
  ],
  "capabilities": [
    "authentication",
    "file-management",
    "storage-management",
    "docker-management",
    "download-tasks",
    "system-monitoring",
    "network-management",
    "user-management",
    "photo-library",
    "baidu-netdisk"
  ],
  "documentation": {
    "schema": 1,
    "locale": "zh-CN",
    "modules": [
      "core",
      "files",
      "applications",
      "system"
    ],
    "complete": true,
    "files": [
      "SKILL.md",
      "entries/trim-shared.md",
      "reference/_conventions.md",
      "reference/_index.md",
      "reference/oauth.md",
      "entries/trim-file.md",
      "entries/trim-photos.md",
      "reference/file.md",
      "reference/photos.md",
      "reference/workflows/file-routing.md",
      "reference/workflows/file-upload-validation.md",
      "reference/workflows/photos-routing.md",
      "entries/trim-app.md",
      "entries/trim-docker.md",
      "entries/trim-download.md",
      "entries/trim-baidu-netdisk.md",
      "reference/app-center.md",
      "reference/dockermgr.md",
      "reference/download.md",
      "reference/baidu-netdisk.md",
      "entries/trim-log.md",
      "entries/trim-monitor.md",
      "entries/trim-network.md",
      "entries/trim-storage.md",
      "entries/trim-system.md",
      "entries/trim-user.md",
      "reference/log.md",
      "reference/resmon.md",
      "reference/network.md",
